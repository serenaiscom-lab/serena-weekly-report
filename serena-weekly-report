      const removeWorkItem = (sIdx, itemIdx) => {
        const updated = [...formData.workSections];
        updated[sIdx].items = updated[sIdx].items.filter((_, i) => i !== itemIdx);
        setFormData({ ...formData, workSections: updated });
      };

      const handleWorkItemChange = (sIdx, itemIdx, field, val) => {
