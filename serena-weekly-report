              { id: "w-3", title: "FB 粉絲專頁雙週曝光與互動分析", status: "延遲排解", result: "因權限問題 delay，已聯繫 IT 部門處理中", owner: "Mark" }
            ]
          }
        ],

        marketingMetrics: [
          { id: "m-1", category: "GA4 網站數據", name: "GA4 總數使用者", val: 12500, prev: 11000, unit: "人", isInverted: false },
          { id: "m-2", category: "GA4 網站數據", name: "GA4 新使用者", val: 8200, prev: 7500, unit: "人", isInverted: false },
          { id: "m-3", category: "GA4 網站數據", name: "官網轉換名單數", val: 320, prev: 280, unit: "筆", isInverted: false },
          { id: "m-4", category: "GA4 網站數據", name: "官網名單轉換率", val: 2.56, prev: 2.25, unit: "%", isInverted: false },
          { id: "m-5", category: "GSC 自然搜尋", name: "GSC 自然搜尋點擊", val: 4500, prev: 4100, unit: "次", isInverted: false },
          { id: "m-6", category: "GSC 自然搜尋", name: "GSC 總曝光次數", val: 98000, prev: 85000, unit: "次", isInverted: false },
          { id: "m-7", category: "GSC 自然搜尋", name: "GSC 平均點擊率 (CTR)", val: 4.59, prev: 4.82, unit: "%", isInverted: false },
          { id: "m-8", category: "GSC 自然搜尋", name: "GSC 平均排名", val: 12.3, prev: 14.1, unit: "名", isInverted: true },
          { id: "m-9", category: "FB 社群經營", name: "FB 社群總觸及數", val: 35000, prev: 42000, unit: "次", isInverted: false },
          { id: "m-10", category: "FB 社群經營", name: "FB 貼文互動次數", val: 2800, prev: 2500, unit: "次", isInverted: false },
          { id: "m-11", category: "FB 社群經營", name: "FB 私訊與留單諮詢", val: 45, prev: 38, unit: "筆", isInverted: false }
        ]
      };
    };

    // 🎴 數據卡片組件
    function MetricCard({ metric, compact = false }) {
      const { name, val, prev, unit, isInverted } = metric;
      const diff = val - prev;
      const absDiff = Math.abs(diff);
      const pct = prev !== 0 ? ((diff / prev) * 100).toFixed(1) : 0;
      const isZero = diff === 0;

      let isGood = isInverted ? diff < 0 : diff > 0;

      let badgeBg = '';
      if (isZero) {
        badgeBg = 'bg-slate-100 text-slate-600 border-slate-200';
      } else if (isInverted) {
        badgeBg = isGood 
          ? 'bg-rose-50 text-rose-700 border-rose-200'  
          : 'bg-emerald-50 text-emerald-700 border-emerald-200'; 
      } else {
        badgeBg = isGood 
          ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
          : 'bg-rose-50 text-rose-700 border-rose-200';  
      }

      let displayBadgeText = '';
      if (isZero) {
        displayBadgeText = '▬ 持平';
      } else if (isInverted) {
        const rankDiffText = formatDiffVal(absDiff);
        displayBadgeText = diff < 0 
          ? `▲ 上升 ${rankDiffText} 名` 
          : `▼ 下降 ${rankDiffText} 名`;
      } else {
        displayBadgeText = `${diff > 0 ? '▲' : '▼'} ${Math.abs(pct)}%`;
      }

      const formattedDiffStr = diff > 0 ? `+${formatDiffVal(diff)}` : formatDiffVal(diff);

      if (compact) {
        return (
          <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm space-y-1">
            <div class="text-[11px] text-slate-500 font-medium truncate">{name}</div>
            <div class="flex items-baseline justify-between gap-1 flex-wrap">
              <span class="text-base font-black text-slate-800">
                {val.toLocaleString()} <span class="text-[10px] font-normal text-slate-400">{unit}</span>
              </span>
              <span class={`text-[10px] font-bold px-1.5 py-0.5 rounded border shrink-0 ${badgeBg}`}>
                {displayBadgeText}
              </span>
            </div>
            <div class="text-[10px] text-slate-400 flex justify-between pt-1 border-t">
              <span>上週: {prev.toLocaleString()}</span>
              <span>差額: {formattedDiffStr}</span>
            </div>
          </div>
        );
      }

      return (
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition space-y-3">
          <div class="flex justify-between items-start gap-2">
            <span class="text-xs font-bold text-slate-700 truncate">{name}</span>
            <span class={`text-[11px] font-extrabold px-2 py-0.5 rounded-full border shrink-0 ${badgeBg}`}>
              {displayBadgeText}
            </span>
          </div>

          <div class="flex items-baseline justify-between">
            <div>
              <span class="text-2xl font-black text-slate-900 tracking-tight">{val.toLocaleString()}</span>
              <span class="text-xs font-medium text-slate-500 ml-1">{unit}</span>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500 font-medium">
            <div>
              上週數據：<span class="font-bold text-slate-700">{prev.toLocaleString()} {unit}</span>
            </div>
            <div>
              週變化：
              <span class={`font-bold ${badgeBg.includes('rose') ? 'text-rose-600' : 'text-emerald-600'}`}>
                {formattedDiffStr} {isInverted && absDiff !== 0 ? '名' : ''}
              </span>
            </div>
          </div>
        </div>
      );
    }

    // ⚡ 綜合大綱摘要卡片
    function ExecutiveSummaryCard({ summaryText, onUpdateSummary, onRegenerate }) {
      const [isEditing, setIsEditing] = useState(false);
      const [tempText, setTempText] = useState(summaryText || "");

      useEffect(() => {
        setTempText(summaryText || "");
      }, [summaryText]);

      if (!summaryText && !isEditing) return null;

      const handleSave = () => {
        onUpdateSummary(tempText);
        setIsEditing(false);
      };

      const handleDelete = () => {
        if (window.confirm("❓ 確定要刪除這份大綱摘要嗎？")) {
          onUpdateSummary("");
          setIsEditing(false);
        }
      };

      return (
        <div class="bg-amber-50 border border-amber-200 p-4 rounded-xl space-y-3 shadow-sm">
          <div class="flex justify-between items-center no-print flex-wrap gap-2">
            <h3 class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
              <span>⚡</span> 綜合大綱摘要 (Executive Summary)
              <span class="text-[10px] font-normal text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded">可人工編輯</span>
            </h3>
            
            <div class="flex items-center space-x-1.5">
              {isEditing ? (
                <>
                  <button onClick={() => setIsEditing(false)} class="text-xs bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-2.5 py-1 rounded transition">取消</button>
                  <button onClick={handleSave} class="text-xs bg-amber-600 hover:bg-amber-700 text-white font-bold px-3 py-1 rounded shadow-sm transition">💾 儲存摘要</button>
                </>
              ) : (
                <>
                  <button onClick={onRegenerate} class="text-xs bg-amber-200/80 hover:bg-amber-300 text-amber-900 font-bold px-2 py-1 rounded transition flex items-center gap-1">🔄 重新整理</button>
                  <button onClick={() => setIsEditing(true)} class="text-xs bg-amber-200 hover:bg-amber-300 text-amber-900 font-bold px-2 py-1 rounded transition flex items-center gap-1">✏️ 編輯</button>
                  <button onClick={handleDelete} class="text-xs bg-rose-100 hover:bg-rose-200 text-rose-800 font-bold px-2 py-1 rounded transition flex items-center gap-1 border border-rose-200">🗑️ 刪除</button>
                </>
              )}
            </div>
          </div>

          {isEditing ? (
            <textarea 
              rows="7" 
              class="w-full text-xs font-sans p-3 rounded-lg border border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white leading-relaxed text-slate-800"
              value={tempText}
              onChange={(e) => setTempText(e.target.value)}
            ></textarea>
          ) : (
            <pre class="text-xs text-amber-950 font-sans whitespace-pre-wrap leading-relaxed">{summaryText}</pre>
          )}
        </div>
      );
    }

    // 🏷️ 狀態 Badge
    function StatusBadge({ status }) {
      if (status === "已完成") {
        return (
          <span class="inline-flex items-center gap-1 bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full text-[11px] font-bold border border-slate-300">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> ✓ 已完成
          </span>
        );
      }
      if (status === "延遲排解") {
        return (
          <span class="inline-flex items-center gap-1 bg-rose-100 text-rose-800 px-2.5 py-0.5 rounded-full text-[11px] font-bold border border-rose-200">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span> ⚠️ 延遲排解
          </span>
        );
      }
      return (
        <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full text-[11px] font-bold border border-emerald-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> ⏳ 進行中
        </span>
      );
    }

    // 🔔 獨立全域右側通知提醒側邊欄 (Right Sidebar)
    function RightReminderSidebar({ reminders, setReminders }) {
      const [type, setType] = useState("待辦事項");
      const [title, setTitle] = useState("");
      
      const getNowDateTimeString = () => {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        return `${year}-${month}-${day}T${hours}:${minutes}`;
      };

      const [dateTime, setDateTime] = useState(getNowDateTimeString());
      const [priority, setPriority] = useState("中");
      const [note, setNote] = useState("");
      const [timeFilter, setTimeFilter] = useState("all");

      const handleAdd = (e) => {
        e.preventDefault();
        if (!title.trim()) {
          alert("請輸入事項名稱！");
          return;
        }
        const newRem = {
          id: `rem-${Date.now()}`,
          type,
          title,
          dateTime: dateTime || getNowDateTimeString(),
          priority,
          status: "未完成",
          note
        };
        setReminders([newRem, ...reminders]);
        setTitle("");
        setDateTime(getNowDateTimeString());
        setNote("");
      };

      const toggleStatus = (id) => {
        setReminders(reminders.map(r => r.id === id ? { ...r, status: r.status === '已完成' ? '未完成' : '已完成' } : r));
      };

      const deleteReminder = (id) => {
        if (window.confirm("❓ 確定要刪除這筆提醒嗎？")) {
          setReminders(reminders.filter(r => r.id !== id));
        }
      };

      const filterByTime = (itemDateTimeStr) => {
        if (timeFilter === "all" || !itemDateTimeStr) return true;
        const itemDateStr = itemDateTimeStr.split("T")[0];
        const now = new Date();
        const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

        if (timeFilter === "today") return itemDateStr === todayStr;
        if (timeFilter === "month") {
          const itemDate = new Date(itemDateStr);
          return itemDate.getFullYear() === now.getFullYear() && itemDate.getMonth() === now.getMonth();
        }
        return true;
      };

      const filteredReminders = useMemo(() => {
        return reminders.filter(r => filterByTime(r.dateTime));
      }, [reminders, timeFilter]);

      const pendingList = filteredReminders.filter(r => r.status !== "已完成");
      const completedList = filteredReminders.filter(r => r.status === "已完成");

      return (
        <aside class="w-full lg:w-80 bg-white border-l border-slate-200 p-4 space-y-5 no-print shrink-0 shadow-sm rounded-xl lg:rounded-none">
          <div class="flex items-center justify-between border-b pb-3">
            <h2 class="text-sm font-black text-slate-800 flex items-center gap-1.5">
              <span>🔔</span> 獨立通知提醒 (全域同步)
            </h2>
            <span class="bg-rose-100 text-rose-700 font-bold text-[10px] px-2 py-0.5 rounded-full">
              未完成 {pendingList.length}
            </span>
          </div>

          {/* 時間篩選 */}
          <div class="flex items-center justify-between text-xs bg-slate-50 p-2 rounded-lg border border-slate-200">
            <span class="font-bold text-slate-600">📅 篩選：</span>
            <select 
              class="text-xs font-bold border border-slate-300 p-1 rounded bg-white outline-none focus:ring-1 focus:ring-rose-500 text-slate-800"
              value={timeFilter}
              onChange={e => setTimeFilter(e.target.value)}
            >
              <option value="all">全部事項</option>
              <option value="today">本日事項</option>
              <option value="month">本月事項</option>
            </select>
          </div>

          {/* 快速新增提醒 */}
          <form onSubmit={handleAdd} class="bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2.5">
            <div class="text-[11px] font-bold text-slate-700 flex justify-between">
              <span>➕ 新增獨立事項</span>
            </div>
            
            <div class="grid grid-cols-2 gap-2">
              <select class="text-xs border p-1.5 rounded bg-white" value={type} onChange={e=>setType(e.target.value)}>
                <option value="待辦事項">📌 待辦</option>
                <option value="會議">📅 會議</option>
              </select>
              <select class="text-xs border p-1.5 rounded bg-white font-bold" value={priority} onChange={e=>setPriority(e.target.value)}>
                <option value="高">🔴 高優先</option>
                <option value="中">🟡 中優先</option>
                <option value="低">🟢 低優先</option>
              </select>
            </div>

            <input 
              type="text" 
              placeholder="事項 / 會議名稱..." 
              class="w-full text-xs border p-1.5 rounded bg-white" 
              value={title} 
              onChange={e=>setTitle(e.target.value)} 
            />

            <input 
              type="datetime-local" 
              class="w-full text-xs border p-1.5 rounded bg-white text-slate-600" 
              value={dateTime} 
              onChange={e=>setDateTime(e.target.value)} 
            />

            <input 
              type="text" 
              placeholder="備註說明 (選填)..." 
              class="w-full text-xs border p-1.5 rounded bg-white" 
              value={note} 
              onChange={e=>setNote(e.target.value)} 
            />

            <button type="submit" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-1.5 rounded shadow-sm transition">
              ➕ 新增提醒
            </button>
          </form>

          {/* 進行中事項列表 */}
          <div class="space-y-2">
            <div class="text-xs font-bold text-amber-700 flex justify-between items-center border-b pb-1">
              <span>⏳ 進行中 ({pendingList.length})</span>
            </div>
            <div class="space-y-2 max-h-60 overflow-y-auto pr-1">
              {pendingList.length === 0 ? (
                <div class="text-[11px] text-slate-400 text-center py-3">無進行中事項</div>
              ) : pendingList.map(r => (
                <div key={r.id} class="p-2.5 rounded-lg border border-amber-200 bg-amber-50/40 space-y-1 hover:border-amber-400 transition">
                  <div class="flex items-start justify-between gap-1">
                    <div class="flex items-start gap-1.5">
                      <input 
                        type="checkbox" 
                        checked={false} 
                        onChange={() => toggleStatus(r.id)} 
                        class="mt-0.5 w-3.5 h-3.5 cursor-pointer text-emerald-600 rounded"
                      />
                      <span class="text-xs font-bold text-slate-800 leading-tight">{r.title}</span>
                    </div>
                    <button onClick={() => deleteReminder(r.id)} class="text-[10px] text-rose-500 hover:underline">✕</button>
                  </div>
                  
                  <div class="flex items-center justify-between text-[10px] text-slate-500 pl-5">
                    <span>{r.dateTime.replace('T', ' ')}</span>
                    <span class={`px-1.5 py-0.2 rounded font-bold ${r.priority === '高' ? 'bg-rose-100 text-rose-700' : 'bg-slate-200 text-slate-700'}`}>
                      {r.priority}
                    </span>
                  </div>
                  {r.note && <div class="text-[10px] text-slate-400 pl-5 truncate">{r.note}</div>}
                </div>
              ))}
            </div>
          </div>

          {/* 已完成事項列表 */}
          <div class="space-y-2 pt-2 border-t">
            <div class="text-xs font-bold text-emerald-700 flex justify-between items-center border-b pb-1">
              <span>✓ 已完成 ({completedList.length})</span>
            </div>
            <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
              {completedList.length === 0 ? (
                <div class="text-[11px] text-slate-400 text-center py-2">無已完成事項</div>
              ) : completedList.map(r => (
                <div key={r.id} class="p-2 rounded-lg border border-slate-200 bg-slate-50 opacity-60 hover:opacity-100 transition space-y-1">
                  <div class="flex items-start justify-between gap-1">
