            </div>
            <div class="flex items-center space-x-2">
              <button onClick={addMetric} class="bg-purple-600 text-white text-xs px-3 py-1.5 rounded font-bold">+ 新增數據欄位</button>
            </div>
          </div>

          <div class="space-y-2">
            {formData.marketingMetrics.map((m, idx) => (
              <div key={m.id} class="grid grid-cols-1 md:grid-cols-12 gap-2 items-center bg-slate-50 p-2 rounded border">
                <input type="text" placeholder="類別" class="text-xs border p-1.5 rounded col-span-2 bg-white" value={m.category} onChange={e=>handleMetricChange(idx, 'category', e.target.value)} />
                <input type="text" placeholder="指標名稱" class="text-xs border p-1.5 rounded col-span-3 bg-white" value={m.name} onChange={e=>handleMetricChange(idx, 'name', e.target.value)} />
                <div class="flex gap-1 col-span-3">
                  <input type="number" step="0.1" placeholder="本週" class="w-1/2 text-xs border p-1.5 rounded font-bold text-blue-700 bg-white" value={m.val} onChange={e=>handleMetricChange(idx, 'val', e.target.value)} />
                  <input type="number" step="0.1" placeholder="上週" class="w-1/2 text-xs border p-1.5 rounded bg-white text-slate-500" value={m.prev} onChange={e=>handleMetricChange(idx, 'prev', e.target.value)} />
                </div>
                <input type="text" placeholder="單位" class="text-xs border p-1.5 rounded col-span-1 bg-white" value={m.unit} onChange={e=>handleMetricChange(idx, 'unit', e.target.value)} />
                
                <div class="col-span-3 flex items-center justify-between pl-1">
                  <label class="flex items-center gap-1 text-[11px] text-slate-700 cursor-pointer font-medium" title="勾選後將顯示順位差，排名數字變小代表上升（顯示紅底）">
                    <input 
                      type="checkbox" 
                      checked={Boolean(m.isInverted)} 
                      onChange={e => handleMetricChange(idx, 'isInverted', e.target.checked)}
                      class="rounded text-rose-600"
                    />
                    <span>排名指標邏輯 (顯示順位差/紅底)</span>
                  </label>

                  <button onClick={()=>removeMetric(idx)} class="text-rose-600 text-xs font-bold hover:underline">刪除 ✕</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById("root"));
    root.render(<App />);
  </script>
</body>
</html>
