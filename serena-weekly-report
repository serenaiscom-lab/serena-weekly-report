    // 📜 歷史報表區 View (已修正：刪除ID、新增全部/本週/本月/本年與日期範圍篩選)
    function HistoryReportsTab({ reports, onSelectAndEdit, onDuplicate, onDelete, onSelectView }) {
      const [searchTerm, setSearchTerm] = useState("");
      const [filterStatus, setFilterStatus] = useState("ALL");
      const [timePeriodFilter, setTimePeriodFilter] = useState("ALL"); // ALL, WEEK, MONTH, YEAR
      const [startDateFilter, setStartDateFilter] = useState("");
      const [endDateFilter, setEndDateFilter] = useState("");

      const filteredReports = useMemo(() => {
        const now = new Date();

        return reports.filter(r => {
          // 1. 關鍵字搜尋（週次、填表人、日期）
          const matchSearch = (r.weekCode || "").toLowerCase().includes(searchTerm.toLowerCase()) ||
                              (r.author || "").toLowerCase().includes(searchTerm.toLowerCase()) ||
                              (r.createdTime || "").includes(searchTerm) ||
                              (r.startDate || "").includes(searchTerm) ||
                              (r.endDate || "").includes(searchTerm);

          // 2. 狀態篩選
          const matchStatus = filterStatus === "ALL" ? true : r.status === filterStatus;

          // 3. 快捷時間區間篩選 (依據建立時間 createdTime 或 startDate)
          let matchTimePeriod = true;
          const repDateStr = (r.createdTime ? r.createdTime.split(" ")[0] : r.startDate) || "";
          
          if (repDateStr && timePeriodFilter !== "ALL") {
            const repDate = new Date(repDateStr);
            if (!isNaN(repDate.getTime())) {
              if (timePeriodFilter === "WEEK") {
                // 本週計算 (以週日為始或一週內)
                const currentDay = now.getDay();
                const firstDayOfWeek = new Date(now);
                firstDayOfWeek.setDate(now.getDate() - currentDay);
                firstDayOfWeek.setHours(0,0,0,0);
                
                const lastDayOfWeek = new Date(firstDayOfWeek);
                lastDayOfWeek.setDate(firstDayOfWeek.getDate() + 6);
                lastDayOfWeek.setHours(23,59,59,999);

                matchTimePeriod = repDate >= firstDayOfWeek && repDate <= lastDayOfWeek;
              } else if (timePeriodFilter === "MONTH") {
                matchTimePeriod = repDate.getFullYear() === now.getFullYear() && repDate.getMonth() === now.getMonth();
              } else if (timePeriodFilter === "YEAR") {
                matchTimePeriod = repDate.getFullYear() === now.getFullYear();
              }
            }
          }

          // 4. 自訂日期區間篩選
          let matchCustomDate = true;
          if (repDateStr) {
            if (startDateFilter && repDateStr < startDateFilter) matchCustomDate = false;
            if (endDateFilter && repDateStr > endDateFilter) matchCustomDate = false;
          }

          return matchSearch && matchStatus && matchTimePeriod && matchCustomDate;
        });
      }, [reports, searchTerm, filterStatus, timePeriodFilter, startDateFilter, endDateFilter]);

      return (
        <div class="space-y-6">
          <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
            <div class="flex flex-wrap justify-between items-center gap-2 border-b pb-3">
              <div>
                <h2 class="text-xl font-black text-slate-800">📜 歷史報表紀錄區</h2>
                <p class="text-xs text-slate-500 mt-0.5">查詢版本歷史、建立/更新時間與快速複製檢視</p>
              </div>
              <div class="text-xs font-bold text-slate-500">
                共篩選出 <span class="text-blue-600 font-extrabold">{filteredReports.length}</span> 份報表
              </div>
            </div>

            {/* 篩選工具列 */}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 pt-1">
              {/* 文字搜尋 */}
              <input 
                type="text" 
                placeholder="🔍 搜尋標題、填表人..."
                class="text-xs border p-2 rounded-lg outline-none focus:ring-2 focus:ring-blue-500 bg-white"
                value={searchTerm}
                onChange={e => setSearchTerm(e.target.value)}
              />

              {/* 報表類別快捷篩選 */}
              <select 
                class="text-xs border p-2 rounded-lg bg-white outline-none font-bold text-slate-700 focus:ring-2 focus:ring-blue-500"
                value={timePeriodFilter}
                onChange={e => setTimePeriodFilter(e.target.value)}
              >
                <option value="ALL">🌐 全部報表</option>
                <option value="WEEK">📅 本週報表</option>
                <option value="MONTH">🗓️ 本月報表</option>
                <option value="YEAR">📊 本年報表</option>
              </select>

              {/* 狀態篩選 */}
              <select 
                class="text-xs border p-2 rounded-lg bg-white outline-none font-medium focus:ring-2 focus:ring-blue-500"
                value={filterStatus}
                onChange={e => setFilterStatus(e.target.value)}
              >
                <option value="ALL">全部狀態</option>
                <option value="已發布">已發布</option>
                <option value="草稿">草稿</option>
              </select>

              {/* 開始日期 */}
              <div class="flex items-center gap-1.5 bg-slate-50 border p-1.5 rounded-lg">
                <span class="text-[11px] font-bold text-slate-400 shrink-0">從:</span>
                <input 
                  type="date" 
                  class="text-xs bg-transparent w-full outline-none text-slate-700"
                  value={startDateFilter}
                  onChange={e => setStartDateFilter(e.target.value)}
                />
              </div>

              {/* 結束日期 */}
              <div class="flex items-center gap-1.5 bg-slate-50 border p-1.5 rounded-lg">
                <span class="text-[11px] font-bold text-slate-400 shrink-0">至:</span>
                <input 
                  type="date" 
                  class="text-xs bg-transparent w-full outline-none text-slate-700"
                  value={endDateFilter}
                  onChange={e => setEndDateFilter(e.target.value)}
                />
              </div>
            </div>
            
            {(startDateFilter || endDateFilter || searchTerm || timePeriodFilter !== 'ALL' || filterStatus !== 'ALL') && (
              <div class="flex justify-end pt-1">
                <button 
                  onClick={() => {
                    setSearchTerm("");
                    setFilterStatus("ALL");
                    setTimePeriodFilter("ALL");
                    setStartDateFilter("");
                    setEndDateFilter("");
                  }}
                  class="text-[11px] text-rose-600 hover:underline font-bold flex items-center gap-1"
                >
                  ✕ 清除所有篩選條件
                </button>
              </div>
            )}
          </div>

          {/* 報表卡片列表 */}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {filteredReports.length === 0 ? (
              <div class="col-span-1 md:col-span-2 lg:col-span-3 bg-white p-12 text-center text-slate-400 rounded-xl border border-dashed space-y-2">
                <div class="text-2xl">🔍</div>
                <div class="font-bold text-slate-600">沒有符合條件的報表紀錄</div>
                <div class="text-xs text-slate-400">請嘗試調整您的日期區間或搜尋關鍵字</div>
              </div>
            ) : filteredReports.map(rep => (
              <div key={rep.id} class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4 flex flex-col justify-between hover:border-blue-400 hover:shadow-md transition">
                <div class="space-y-2.5">
                  <div class="flex justify-between items-center">
                    <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full ${rep.status === '已發布' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200'}`}>
                      {rep.status}
                    </span>
                    <span class="text-[10px] text-slate-400 font-medium">建立日期：{rep.createdTime ? rep.createdTime.split(' ')[0] : rep.startDate}</span>
                  </div>

                  <div>
                    <h3 class="text-base font-bold text-slate-800 leading-snug">{rep.weekCode}</h3>
                    <p class="text-xs text-slate-500 mt-1">週報週期：{rep.startDate} ~ {rep.endDate}</p>
                    <p class="text-xs text-slate-500">填表人：<span class="font-bold text-slate-700">{rep.author || 'Serena'}</span></p>
                  </div>

                  <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100 space-y-1 text-[11px] text-slate-500 font-mono">
                    <div class="flex justify-between">
                      <span>📤 建立時間：</span>
                      <span class="font-bold text-slate-700">{rep.createdTime || '—'}</span>
                    </div>
                    <div class="flex justify-between">
                      <span>🔄 更新時間：</span>
                      <span class="font-bold text-slate-700">{rep.updatedTime || '—'}</span>
                    </div>
                  </div>
                </div>

                <div class="space-y-1.5 pt-3 border-t border-slate-100">
                  <div class="grid grid-cols-3 gap-1.5">
                    <button onClick={() => onDuplicate(rep)} class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold py-1.5 rounded transition">📋 複製</button>
                    <button onClick={() => onSelectAndEdit(rep.id)} class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold py-1.5 rounded transition">✏️ 編輯</button>
                    <button onClick={() => onSelectView(rep.id)} class="bg-purple-50 hover:bg-purple-100 text-purple-700 text-xs font-bold py-1.5 rounded border border-purple-200 transition">🔍 檢視</button>
                  </div>
                  <button onClick={() => onDelete(rep.id, rep.weekCode)} class="w-full bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold py-1 rounded transition">🗑️ 刪除報表</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    }

