    function App() {
      const [reports, setReports] = useState(() => {
        const saved = localStorage.getItem("mkt_work_weekly_reports_v17");
        if (saved) {
          try { 
            const parsed = JSON.parse(saved);
            if (parsed && parsed.length > 0) return parsed;
          } catch (e) {}
        }
        return [createDefaultDemoReport()];
      });

      // 🔔 獨立通知提醒資料（完全獨立）
      const [reminders, setReminders] = useState(() => {
        const savedRem = localStorage.getItem("mkt_work_reminders_v1");
        if (savedRem) {
          try { return JSON.parse(savedRem); } catch(e) {}
        }
        const todayStr = new Date().toISOString().slice(0, 10);
        return [
          { id: "rem-1", type: "會議", title: "Q4 行銷策略對齊會議", dateTime: `${todayStr}T14:00`, priority: "高", status: "未完成", note: "需準備簡報草案" },
          { id: "rem-2", type: "待辦事項", title: "審核 FB 廣告預算案", dateTime: `${todayStr}T17:00`, priority: "中", status: "未完成", note: "聯繫主管簽核" }
        ];
      });

      const [selectedReportId, setSelectedReportId] = useState(reports[0]?.id || "");
      const [activeTab, setActiveTab] = useState("overview"); 
      const [editMode, setEditMode] = useState(null); 
      const [formData, setFormData] = useState(null);

      useEffect(() => {
        localStorage.setItem("mkt_work_weekly_reports_v17", JSON.stringify(reports));
      }, [reports]);

      useEffect(() => {
        localStorage.setItem("mkt_work_reminders_v1", JSON.stringify(reminders));
      }, [reminders]);

      const activeReport = reports.find(r => r.id === selectedReportId) || reports[0] || createTotallyBlankReport();

      const handleCreateBlankReport = () => {
        const newBlank = createTotallyBlankReport();
        setReports([newBlank, ...reports]);
        setSelectedReportId(newBlank.id);
        setFormData(newBlank);
        setActiveTab("work");
        setEditMode("work");
        alert("✨ 已建立空白報表！");
      };

      const handleDuplicateReport = (targetReport) => {
        const nowTime = getFormattedDateTime();
        const duplicated = {
          ...JSON.parse(JSON.stringify(targetReport)),
          id: `rep-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,
          weekCode: `${targetReport.weekCode} (複製)`,
          status: "草稿",
          createdTime: nowTime,
          updatedTime: nowTime
        };
        setReports([duplicated, ...reports]);
        setSelectedReportId(duplicated.id);
        setFormData(duplicated);
        setActiveTab("work");
        setEditMode("work");
        alert(`📋 已成功複製「${targetReport.weekCode}」！`);
      };

      const handleDeleteReport = (targetId, targetWeekCode) => {
        if (reports.length <= 1) {
          alert("⚠️ 系統至少需保留一份報表，無法刪除！");
          return;
        }
        if (!window.confirm(`❓ 確定要刪除「${targetWeekCode || '此報表'}」嗎？`)) return;

        const updatedReports = reports.filter(r => r.id !== targetId);
        setReports(updatedReports);

        if (targetId === selectedReportId) {
          setSelectedReportId(updatedReports[0].id);
          setEditMode(null);
        }
        alert("🗑️ 報表已成功刪除！");
      };

      const handleStartWorkEdit = () => {
        setFormData(JSON.parse(JSON.stringify(activeReport)));
        setEditMode("work");
      };

      const handleStartAnalyticsEdit = () => {
        setFormData(JSON.parse(JSON.stringify(activeReport)));
        setEditMode("analytics");
      };

      const handleSave = (targetStatus = "草稿") => {
        const updatedTime = getFormattedDateTime();
        const baseData = editMode ? formData : activeReport;
        
        const updated = { 
          ...baseData, 
          status: targetStatus,
          updatedTime: updatedTime
        };
        
        setReports(reports.map(r => r.id === updated.id ? updated : r));
        setEditMode(null);
        alert(`✅ 週報【${updated.weekCode}】已成功【${targetStatus}】！`);
      };

      const handleUpdateExecutiveSummary = (newSummaryText) => {
        const updatedTime = getFormattedDateTime();
        if (editMode && formData) {
          setFormData({ ...formData, aiExecutiveSummary: newSummaryText });
        } else {
          const updated = { ...activeReport, aiExecutiveSummary: newSummaryText, updatedTime: updatedTime };
          setReports(reports.map(r => r.id === updated.id ? updated : r));
        }
      };

      const handleGenerateGlobalSummary = () => {
        const target = editMode ? formData : activeReport;
        const sections = target.workSections || [];
        let allItems = [];
        sections.forEach(s => { allItems = allItems.concat(s.items || []); });

        const completed = allItems.filter(i => i.status === "已完成");
        const ongoing = allItems.filter(i => i.status === "進行中");
        const delayed = allItems.filter(i => i.status === "延遲排解");

        const summaryText = `📊 【全頁綜合大綱摘要】 (填表人：${target.author || 'Serena'})

一、 本週推進概況：
• ${target.summary || '進度正常推進。'}
• 工作分區管控：共 ${sections.length} 個區塊，總計 ${allItems.length} 項工作（🟢 進行中 ${ongoing.length} 項 / ⚪ 已完成 ${completed.length} 項 / 🔴 延遲排解 ${delayed.length} 項）

二、 關鍵成果與亮點數據：
• 專案突破：${target.keyWins ? target.keyWins.replace(/\n/g, ' ') : '無'}

三、 須關注警示與協助：
• 須協助/決策：${target.decisionsNeed ? target.decisionsNeed.replace(/\n/g, ' ') : '無'}
${delayed.length > 0 ? `• 延遲項目排解：包含「${delayed.map(d=>d.title).join('」、「')}」，需要跨部門支援。` : ''}

四、 下週重點排程安排：
• ${target.nextWeekP1 ? target.nextWeekP1.replace(/\n/g, ' ') : '依既定排程進行'}`;

        handleUpdateExecutiveSummary(summaryText);
      };

      return (
        <div class="min-h-screen flex flex-col">
          {/* 最上方功能導覽列 */}
          <header class="bg-slate-900 text-white px-6 py-3 flex flex-wrap items-center justify-between shadow-md no-print gap-y-2 border-b border-slate-800">
            <div class="flex items-center space-x-3">
              <div class="bg-blue-600 px-2.5 py-1 rounded font-black text-sm tracking-wider">WORK</div>
              <div>
                <h1 class="font-bold text-sm sm:text-base flex items-center gap-2">
                  行銷與工作推進整合週報系統
                  <span class={`text-[10px] px-2 py-0.5 rounded font-bold ${activeReport.status === '已發布' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'}`}>
                    {activeReport.status}
                  </span>
                </h1>
                <p class="text-[10px] text-slate-400">填表人：{activeReport.author || 'Serena'} ｜ 獨立通知提醒右側欄</p>
              </div>
            </div>

            <div class="flex items-center space-x-2 text-xs flex-wrap gap-y-2">
              <button 
                onClick={handleGenerateGlobalSummary}
                class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold px-3 py-1.5 rounded shadow-sm transition flex items-center gap-1"
              >
                ⚡ 一鍵生成摘要
              </button>

              <div class="h-4 w-px bg-slate-700 mx-1"></div>

              <button onClick={() => handleSave("草稿")} class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 font-bold px-3 py-1.5 rounded transition">💾 儲存草稿</button>
              <button onClick={() => handleSave("已發布")} class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3.5 py-1.5 rounded shadow-sm transition">🚀 發布報表</button>

              <div class="h-4 w-px bg-slate-700 mx-1"></div>

              <select 
                class="bg-slate-800 border border-slate-700 text-white rounded px-2.5 py-1.5 outline-none font-medium max-w-[150px] truncate"
                value={selectedReportId}
                onChange={(e) => {
                  setSelectedReportId(e.target.value);
                  setEditMode(null);
                }}
              >
                {reports.map(r => (
                  <option key={r.id} value={r.id}>{r.weekCode} ({r.status})</option>
                ))}
              </select>

              <button onClick={handleCreateBlankReport} class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-3 py-1.5 rounded shadow-sm transition">➕ 新增空白報表</button>
              <button onClick={() => handleDeleteReport(activeReport.id, activeReport.weekCode)} class="bg-rose-900/40 hover:bg-rose-800 text-rose-300 border border-rose-700/60 font-bold px-2.5 py-1.5 rounded transition">🗑️ 刪除</button>
              <button onClick={handleExportPDF} class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-1.5 rounded shadow-sm transition flex items-center gap-1">📄 匯出 PDF</button>

              {editMode && (
                <button onClick={() => setEditMode(null)} class="text-slate-400 hover:text-white px-2">取消編輯</button>
              )}
            </div>
          </header>

          {/* 分頁切換列 */}
          <div class="bg-white border-b border-slate-200 px-6 pt-3 flex space-x-4 no-print overflow-x-auto">
            <button 
              onClick={() => { setEditMode(null); setActiveTab("overview"); }}
              class={`pb-3 text-sm font-bold border-b-2 transition whitespace-nowrap ${activeTab === 'overview' ? 'border-purple-600 text-purple-600' : 'border-transparent text-slate-500 hover:text-slate-800'}`}
            >
              🖥️ 整合儀表板
            </button>
            <button 
              onClick={() => { setEditMode(null); setActiveTab("work"); }}
              class={`pb-3 text-sm font-bold border-b-2 transition whitespace-nowrap ${activeTab === 'work' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}`}
            >
              📋 工作內容總表
            </button>
            <button 
              onClick={() => { setEditMode(null); setActiveTab("analytics"); }}
              class={`pb-3 text-sm font-bold border-b-2 transition whitespace-nowrap ${activeTab === 'analytics' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}`}
            >
              📊 行銷數據儀表板
            </button>
            <button 
              onClick={() => { setEditMode(null); setActiveTab("history"); }}
              class={`pb-3 text-sm font-bold border-b-2 transition whitespace-nowrap ${activeTab === 'history' ? 'border-amber-600 text-amber-600' : 'border-transparent text-slate-500 hover:text-slate-800'}`}
            >
              📜 歷史報表區 ({reports.length})
            </button>
          </div>

          {/* 兩欄主版面 */}
          <div class="flex-1 flex flex-col lg:flex-row main-layout overflow-hidden">
            <main class="flex-1 p-4 sm:p-6 overflow-y-auto">
              {editMode === 'work' && (
                <WorkEditView formData={formData} setFormData={setFormData} onSave={handleSave} />
              )}

              {editMode === 'analytics' && (
                <AnalyticsEditView formData={formData} setFormData={setFormData} onSave={handleSave} />
              )}

              {!editMode && (
                <>
                  {activeTab === "overview" && (
                    <FullOverviewTab 
                      report={activeReport} 
                      onStartWorkEdit={handleStartWorkEdit}
                      onStartAnalyticsEdit={handleStartAnalyticsEdit}
                      onUpdateSummary={handleUpdateExecutiveSummary}
                      onRegenerate={handleGenerateGlobalSummary}
                    />
                  )}
                  {activeTab === "work" && (
                    <WorkOverviewTab 
                      report={activeReport} 
                      onStartEdit={handleStartWorkEdit} 
                      onUpdateSummary={handleUpdateExecutiveSummary}
                      onRegenerate={handleGenerateGlobalSummary}
                    />
                  )}
                  {activeTab === "analytics" && (
                    <MarketingAnalyticsTab 
                      report={activeReport} 
                      onStartEdit={handleStartAnalyticsEdit} 
                    />
                  )}
                  {activeTab === "history" && (
                    <HistoryReportsTab 
                      reports={reports}
                      onSelectAndEdit={(id) => {
                        setSelectedReportId(id);
                        const rep = reports.find(r => r.id === id);
                        setFormData(JSON.parse(JSON.stringify(rep)));
                        setActiveTab("work");
                        setEditMode("work");
                      }}
                      onDuplicate={(rep) => handleDuplicateReport(rep)}
                      onDelete={(id, weekCode) => handleDeleteReport(id, weekCode)}
                      onSelectView={(id) => {
                        setSelectedReportId(id);
                        setActiveTab("overview");
                      }}
                    />
                  )}
                </>
              )}
            </main>

            {/* 獨立右側欄 */}
            <RightReminderSidebar reminders={reminders} setReminders={setReminders} />
          </div>
        </div>
      );
    }

